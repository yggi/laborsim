{
  "name": "laborsim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Patlabor-themed Labor design, operation and safety training simulator",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --project node",
    "drive": "vitest run --project drive",
    "test:watch": "vitest --project node",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "shots": "node scripts/shots.mjs",
    "cab": "node scripts/cab.mjs",
    "yard": "node scripts/yard.mjs",
    "listen": "node scripts/listen.mjs",
    "profile": "node scripts/profile.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.62.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "^0.20.0",
    "three": "^0.185.1"
  }
}
