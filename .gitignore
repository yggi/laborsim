# dependencies
node_modules/

# build output (anchored — src/build/ is source, not output)
/dist/
/build/
.cache/

# editor / os
.DS_Store
.idea/
.vscode/
*.swp

# logs
*.log
npm-debug.log*

# env
.env
.env.local

# Sandbox screenshots. Evidence, not artifacts — regenerate with `npm run shots`.
shots/

# Audio renders. Same reasoning — regenerate with `npm run listen`.
renders/

# Browser-suite evidence: failure screenshots and attachments. Same reasoning as
# `shots/` — regenerate by running the suite.
.vitest-attachments/
tests/browser/__screenshots__/
